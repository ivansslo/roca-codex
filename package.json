{
  "name": "rocagent",
  "version": "5.22.0",
  "description": "Autonomous AI agent & orchestrator that executes real shell commands on your own hardware.",
  "author": "Ivan Ssl (ivansslo)",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ivansslo/RocAgent.git"
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx server.ts",
    "webui": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx server.ts",
    "build": "node scripts/check-rollup.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "postinstall": "node scripts/postinstall.js",
    "lint": "tsc --noEmit",
    "test": "tsx server/__tests__/commandGuard.test.ts && tsx server/__tests__/shellGuard.integration.test.ts && tsx server/__tests__/auth.test.ts && tsx server/__tests__/endpoints.integration.test.ts && tsx server/__tests__/ociVmRootdFs.test.ts && tsx server/__tests__/neonDb.test.ts && tsx server/__tests__/decryptFile.test.ts && bash tools/__tests__/rocvault.test.sh",
    "test:guard": "tsx server/__tests__/commandGuard.test.ts",
    "test:auth": "tsx server/__tests__/auth.test.ts",
    "test:endpoints": "tsx server/__tests__/endpoints.integration.test.ts",
    "test:vault": "bash tools/__tests__/rocvault.test.sh",
    "cli": "tsx rocagent-cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "ssh2": "^1.17.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
