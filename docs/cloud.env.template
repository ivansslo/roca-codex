# ══════════════════════════════════════════════════════════════════
#  Kredensial infrastruktur cloud
#  Lokasi : ~/.config/rocagent/cloud.env
#  Izin   : chmod 600  (direktori chmod 700)
#  JANGAN : commit ke git, taruh di /sdcard, tempel ke chat
# ══════════════════════════════════════════════════════════════════
#
# TERPISAH dari app.env dengan sengaja. RocAgent tidak membaca berkas ini.
# Kalau server disusupi, yang bocor hanya kunci model di app.env — bukan
# kendali atas seluruh infrastrukturmu.
#
# CARA MENGISI
#   Baris yang sudah terisi = identifier non-rahasia, sudah benar, biarkan saja.
#   Baris kosong setelah '='  = tempel nilai HASIL ROTASI.
#   Baris berawalan '#'       = tidak dipakai; hapus '#' bila diperlukan.
#
#   Kalau sebuah layanan tidak kamu pakai, BIARKAN KOSONG. Kredensial
#   menganggur adalah risiko tanpa manfaat.
#
# Rotasi: docs/LANGKAH-ROTASI-5-TERATAS.md
# Setelah diisi: rocvault lock ~/.config/rocagent/cloud.env

# ─── ORACLE CLOUD ────────────────────────────────────────────────
# Kredensial OCI sebenarnya TIDAK perlu di sini — tempatnya ~/.oci/config,
# yang sudah dipakai oci-cli dan kemungkinan besar masih utuh:
#     cat ~/.oci/config
# Yang di bawah hanya rujukan supaya skrip tidak perlu menebak.
OCI_REGION=ap-singapore-1
OCI_VCN=roc-vcn
OCI_SUBNET_NAME=roc-subnet

# Fingerprint HARUS yang terbaru setelah rotasi kunci. Lihat:
#     grep fingerprint ~/.oci/config
# OCI_FINGERPRINT=
# OCI_USER=ocid1.user.oc1..
# OCI_TENANCY=ocid1.tenancy.oc1..
# OCI_SUBNET=ocid1.subnet.oc1.ap-singapore-1..

# Dipakai oleh tool oci_vm (buat/kelola VM lewat oci-cli). Kalau kosong,
# tool jatuh balik ke OCI_TENANCY sebagai compartment root.
# OCI_COMPARTMENT_ID=ocid1.compartment.oc1..

# ─── VM ORACLE (roc-vm-x86) ──────────────────────────────────────
# Alamat, bukan rahasia. Semua port publik sudah ditutup; akses lewat Tailscale.
# Pakai hostname MagicDNS (awsx.tail759f3e.ts.net), bukan IP tailnet mentah --
# IP tailnet sudah berubah 2x sebelumnya (lihat docs/TROUBLESHOOT_IP_CHANGED_100_100_237_104.md),
# hostname MagicDNS tetap stabil walau IP di baliknya berganti.
VM_NAME=roc-vm-x86
VM_TAILSCALE_HOSTNAME=awsx.tail759f3e.ts.net
VM_PUBLIC_IP=161.118.213.55
VM_PRIVATE_IP=10.0.0.26
VM_USER=ubuntu

# Ollama/OCI local model berjalan di dalam VM Oracle di atas -- dipakai
# provider "oci" di server/orchestrator.ts sebagai failover terakhir.
# Pakai hostname yang sama, bukan IP, dengan alasan yang sama di atas.
OCI_MODEL_ENDPOINT=http://awsx.tail759f3e.ts.net:11434
# OCI_MODEL=qwen2.5:7b

# ─── TAILSCALE ───────────────────────────────────────────────────
# Auth key JANGAN disimpan permanen. Buat sekali pakai (ephemeral, 1 hari)
# saat mendaftarkan perangkat, biarkan kedaluwarsa sendiri.
# TAILSCALE_AUTH_KEY=
# TAILSCALE_API_KEY=

# ─── CLOUDFLARE ──────────────────────────────────────────────────
# Rotasi: dash.cloudflare.com/profile/api-tokens  (pakai "Roll")
#
# Account ID bukan rahasia — ia muncul di URL dashboard dan di endpoint R2.
CF_ACCOUNT_ID=
CF_ZONE_ID=

# --- Token per-tujuan ---
# Beri satu variabel per token, JANGAN dijadikan satu "CF_API_TOKEN".
# Token Cloudflare punya cakupan izin berbeda-beda; menumpuknya di satu nama
# membuat kamu tidak tahu yang mana yang sedang dipakai, dan memaksa memberi
# izin berlebih supaya "semua muat".
#
# Namai sesuai label di dashboard supaya mudah dicocokkan saat rotasi.
CF_TOKEN_WORKERS_AI=
CF_TOKEN_ROYAL_LAB=

# --- R2 / S3-compatible object storage ---
# R2 memakai protokol S3, jadi kredensial ini bisa langsung dipakai klien S3
# apa pun (aws-cli, boto3, rclone). Pilih SATU penamaan dan konsisten —
# CF_R2_* dan CF_S3_* merujuk kredensial yang sama, menyimpan keduanya
# hanya membuat salah satunya basi tanpa ketahuan.
# Access Key ID  : 32 karakter heksadesimal
# Secret Access Key: 64 karakter heksadesimal — hanya ditampilkan SEKALI
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Endpoint = https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_R2_ENDPOINT=

# Nama bucket. BOLEH KOSONG kalau kamu belum membuat bucket apa pun —
# kredensial di atas tetap sah, hanya belum ada tempat menyimpan objek.
# Kunci R2 berlaku untuk seluruh akun, bukan per-bucket, jadi variabel ini
# sekadar menunjuk bucket default yang dipakai aplikasi.
# Buat di: dash.cloudflare.com -> R2 -> Create bucket
CF_R2_BUCKET=

# Untuk klien S3 yang menuntut region, R2 selalu "auto".
CF_R2_REGION=auto

# ─── AIVEN POSTGRESQL ────────────────────────────────────────────
# Host sudah dieja BENAR di bawah: aivencloud.com
# Berkas lamamu menulis "aavencloud.com" (dua 'a') di beberapa baris —
# itu typo dan pasti gagal koneksi. Jangan disalin lagi.
AIVEN_PROJECT=roadfrx-ai

# PRIMARY — pg-roadfx (AWS Jakarta)
AIVEN_PG_HOST=pg-roadfx-roadfrx-ai.e.aivencloud.com
AIVEN_PG_PORT=21876
AIVEN_PGBOUNCER_PORT=21877
AIVEN_PG_USER=avnadmin
AIVEN_PG_DB=defaultdb
AIVEN_PG_PASS=
# Isi setelah AIVEN_PG_PASS di atas terisi:
# AIVEN_PG_URI=postgresql://avnadmin:<PASS>@pg-roadfx-roadfrx-ai.e.aivencloud.com:21876/defaultdb?sslmode=require

# SECONDARY — pg-224e6d29 (Google)
AIVEN_PG2_HOST=pg-224e6d29-roadfrx-ai.g.aivencloud.com
AIVEN_PG2_PORT=21876
AIVEN_PG2_USER=avnadmin
AIVEN_PG2_DB=defaultdb
AIVEN_PG2_PASS=
# AIVEN_PG2_URI=postgresql://avnadmin:<PASS>@pg-224e6d29-roadfrx-ai.g.aivencloud.com:21876/defaultdb?sslmode=require

# Token akun Aiven — bisa membuat DAN menghapus database. Perlakukan hati-hati.
# Rotasi: console.aiven.io -> Authentication -> Generate token (max age 30 hari)
# AIVEN_TOKEN=

# ─── NEON POSTGRESQL ─────────────────────────────────────────────
# Rotasi: console.neon.tech -> Settings -> API keys
# NEON_API_KEY=
# NEON_URI=

# ─── MONGODB ─────────────────────────────────────────────────────
# Rotasi: cloud.mongodb.com -> Database Access -> Edit user
# MONGO_URI=

# ─── SNOWFLAKE (Cortex Agent RocAgentInsight) ────────────────────
# Dipakai tool query_snowflake_insight (server/tools.ts) untuk
# bertanya ke Cortex Agent Snowflake dari dalam RocAgent.
# PAT dibuat di: Snowsight -> Admin -> Users & Roles -> user Anda
#   -> Programmatic Access Tokens -> Generate.
# WAJIB: PAT butuh Network Policy yang mengizinkan IP server RocAgent
# Anda -- lihat snowflake/00_network_policy.sql.
# SNOWFLAKE_ACCOUNT=<account-identifier, mis. xy12345.ap-southeast-3.aws>
# SNOWFLAKE_USER=
# SNOWFLAKE_PAT=
# Opsional -- default sudah mengarah ke setup RocAgentInsight bawaan:
# SNOWFLAKE_INSIGHT_DB=ROCAGENTINSIGHT_DB
# SNOWFLAKE_INSIGHT_SCHEMA=GOVERNANCE
# SNOWFLAKE_INSIGHT_AGENT=ROCAGENTINSIGHT

# ══════════════════════════════════════════════════════════════════
# Setelah selesai mengisi:
#
#   chmod 600 ~/.config/rocagent/cloud.env
#   rocvault lock ~/.config/rocagent/cloud.env
#     (lock memverifikasi vault bisa dibuka kembali, LALU menanyakan
#      apakah plaintext dihapus. Jangan jalankan shred sendiri.)
#
# Memakainya:
#   rocvault run ~/.config/rocagent/cloud.env.vault -- <perintah>
#
# Mengubah isinya nanti:
#   rocvault edit ~/.config/rocagent/cloud.env.vault
# ══════════════════════════════════════════════════════════════════
