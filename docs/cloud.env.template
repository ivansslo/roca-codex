# ══════════════════════════════════════════════════════════════════
#  Kredensial infrastruktur cloud
#  Lokasi : ~/.config/rocagent/cloud.env
#  Izin   : chmod 600  (direktori chmod 700)
#  JANGAN : commit ke git, taruh di /sdcard, tempel ke chat
# ══════════════════════════════════════════════════════════════════
#
# TERPISAH dari app.env dengan sengaja. RocAgent tidak membaca berkas ini.
# Kalau server disusupi, yang bocor hanya kunci model di app.env — bukan
# kendali atas seluruh infrastrukturmu.
#
# CARA MENGISI
#   Baris yang sudah terisi = identifier non-rahasia, sudah benar, biarkan saja.
#   Baris kosong setelah '='  = tempel nilai HASIL ROTASI.
#   Baris berawalan '#'       = tidak dipakai; hapus '#' bila diperlukan.
#
#   Kalau sebuah layanan tidak kamu pakai, BIARKAN KOSONG. Kredensial
#   menganggur adalah risiko tanpa manfaat.
#
# Rotasi: docs/LANGKAH-ROTASI-5-TERATAS.md
# Setelah diisi: rocvault lock ~/.config/rocagent/cloud.env

# ─── ORACLE CLOUD ────────────────────────────────────────────────
# Kredensial OCI sebenarnya TIDAK perlu di sini — tempatnya ~/.oci/config,
# yang sudah dipakai oci-cli dan kemungkinan besar masih utuh:
#     cat ~/.oci/config
# Yang di bawah hanya rujukan supaya skrip tidak perlu menebak.
OCI_REGION=ap-singapore-1
OCI_VCN=roc-vcn
OCI_SUBNET_NAME=roc-subnet

# Fingerprint HARUS yang terbaru setelah rotasi kunci. Lihat:
#     grep fingerprint ~/.oci/config
# OCI_FINGERPRINT=
# OCI_USER=ocid1.user.oc1..
# OCI_TENANCY=ocid1.tenancy.oc1..
# OCI_SUBNET=ocid1.subnet.oc1.ap-singapore-1..

# ─── VM ORACLE (roc-vm-x86) ──────────────────────────────────────
# Alamat, bukan rahasia. Semua port publik sudah ditutup; akses lewat Tailscale.
VM_NAME=roc-vm-x86
VM_TAILSCALE_IP=100.125.151.105
VM_PUBLIC_IP=161.118.213.55
VM_PRIVATE_IP=10.0.0.26
VM_USER=ubuntu

# ─── TAILSCALE ───────────────────────────────────────────────────
# Auth key JANGAN disimpan permanen. Buat sekali pakai (ephemeral, 1 hari)
# saat mendaftarkan perangkat, biarkan kedaluwarsa sendiri.
# TAILSCALE_AUTH_KEY=
# TAILSCALE_API_KEY=

# ─── CLOUDFLARE ──────────────────────────────────────────────────
# Rotasi: dash.cloudflare.com/profile/api-tokens  (pakai "Roll")
# CF_ACCOUNT_ID=
# CF_ZONE_ID=
# CF_API_TOKEN=

# R2 (penyimpanan objek) — kredensial terpisah dari token di atas.
# CF_R2_ACCESS=
# CF_R2_SECRET=
# CF_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ─── AIVEN POSTGRESQL ────────────────────────────────────────────
# Host sudah dieja BENAR di bawah: aivencloud.com
# Berkas lamamu menulis "aavencloud.com" (dua 'a') di beberapa baris —
# itu typo dan pasti gagal koneksi. Jangan disalin lagi.
AIVEN_PROJECT=roadfrx-ai

# PRIMARY — pg-roadfx (AWS Jakarta)
AIVEN_PG_HOST=pg-roadfx-roadfrx-ai.e.aivencloud.com
AIVEN_PG_PORT=21876
AIVEN_PGBOUNCER_PORT=21877
AIVEN_PG_USER=avnadmin
AIVEN_PG_DB=defaultdb
AIVEN_PG_PASS=
# Isi setelah AIVEN_PG_PASS di atas terisi:
# AIVEN_PG_URI=postgresql://avnadmin:<PASS>@pg-roadfx-roadfrx-ai.e.aivencloud.com:21876/defaultdb?sslmode=require

# SECONDARY — pg-224e6d29 (Google)
AIVEN_PG2_HOST=pg-224e6d29-roadfrx-ai.g.aivencloud.com
AIVEN_PG2_PORT=21876
AIVEN_PG2_USER=avnadmin
AIVEN_PG2_DB=defaultdb
AIVEN_PG2_PASS=
# AIVEN_PG2_URI=postgresql://avnadmin:<PASS>@pg-224e6d29-roadfrx-ai.g.aivencloud.com:21876/defaultdb?sslmode=require

# Token akun Aiven — bisa membuat DAN menghapus database. Perlakukan hati-hati.
# Rotasi: console.aiven.io -> Authentication -> Generate token (max age 30 hari)
# AIVEN_TOKEN=

# ─── NEON POSTGRESQL ─────────────────────────────────────────────
# Rotasi: console.neon.tech -> Settings -> API keys
# NEON_API_KEY=
# NEON_URI=

# ─── MONGODB ─────────────────────────────────────────────────────
# Rotasi: cloud.mongodb.com -> Database Access -> Edit user
# MONGO_URI=

# ══════════════════════════════════════════════════════════════════
# Setelah selesai mengisi:
#
#   chmod 600 ~/.config/rocagent/cloud.env
#   rocvault lock ~/.config/rocagent/cloud.env
#     (lock memverifikasi vault bisa dibuka kembali, LALU menanyakan
#      apakah plaintext dihapus. Jangan jalankan shred sendiri.)
#
# Memakainya:
#   rocvault run ~/.config/rocagent/cloud.env.vault -- <perintah>
#
# Mengubah isinya nanti:
#   rocvault edit ~/.config/rocagent/cloud.env.vault
# ══════════════════════════════════════════════════════════════════
