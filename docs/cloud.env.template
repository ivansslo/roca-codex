# ══════════════════════════════════════════════════════════════════
#  Kredensial infrastruktur cloud
#  Lokasi : ~/.config/rocagent/cloud.env
#  Izin   : chmod 600  (direktori chmod 700)
#  JANGAN : commit ke git, taruh di /sdcard, tempel ke chat
# ══════════════════════════════════════════════════════════════════
#
# TERPISAH dari app.env dengan sengaja. RocAgent tidak membaca berkas ini.
# Kalau server disusupi, yang bocor hanya kunci model di app.env — bukan
# kendali atas seluruh infrastrukturmu.
#
# Isi dengan nilai HASIL ROTASI. Lihat docs/ROTASI-KREDENSIAL-URGENT.md.
# Kosongkan yang tidak dipakai; jangan simpan kunci yang menganggur.

# ─── ORACLE CLOUD ────────────────────────────────────────────────
# Kredensial OCI sebaiknya TIDAK di sini — tempatnya ~/.oci/config,
# yang sudah dipakai oci-cli. Ini hanya rujukan non-rahasia.
OCI_REGION=ap-singapore-1
OCI_VCN=roc-vcn
# OCI_USER=ocid1.user.oc1..
# OCI_TENANCY=ocid1.tenancy.oc1..
# OCI_FINGERPRINT=          <- pastikan yang TERBARU setelah rotasi kunci
# OCI_SUBNET=ocid1.subnet.oc1..

# ─── TAILSCALE ───────────────────────────────────────────────────
# Alamat tailnet, bukan rahasia. Auth key ADALAH rahasia — jangan
# simpan permanen; buat sekali pakai (ephemeral) saat mendaftarkan node.
TAILSCALE_IP_VM=100.125.151.105
# TAILSCALE_AUTH_KEY=

# ─── CLOUDFLARE ──────────────────────────────────────────────────
# CF_ACCOUNT_ID=
# CF_ZONE_ID=
# CF_API_TOKEN=
# CF_R2_ACCESS=
# CF_R2_SECRET=
# CF_R2_ENDPOINT=

# ─── AIVEN POSTGRESQL ────────────────────────────────────────────
# Perhatikan ejaan host: aivencloud.com  (bukan "aavencloud.com" —
# typo itu ada di env lama dan menyebabkan koneksi gagal).
# AIVEN_PG_HOST=
# AIVEN_PG_PORT=21876
# AIVEN_PG_USER=avnadmin
# AIVEN_PG_PASS=
# AIVEN_PG_DB=defaultdb
# AIVEN_PG_URI=

# ─── NEON POSTGRESQL ─────────────────────────────────────────────
# NEON_API_KEY=
# NEON_URI=

# ─── MONGODB ─────────────────────────────────────────────────────
# MONGO_URI=

# ══════════════════════════════════════════════════════════════════
# Setelah diisi:
#   chmod 600 ~/.config/rocagent/cloud.env
#   rocvault lock ~/.config/rocagent/cloud.env
#   shred -u ~/.config/rocagent/cloud.env
#
# Memakainya:
#   rocvault run ~/.config/rocagent/cloud.env.vault -- <perintah>
# ══════════════════════════════════════════════════════════════════
