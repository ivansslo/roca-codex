# ══════════════════════════════════════════════════════════════════
#  RocAgent — konfigurasi aplikasi
#  Lokasi   : ~/.config/rocagent/app.env
#  Izin     : chmod 600   (chmod 700 pada direktorinya)
#  JANGAN   : commit ke git, taruh di /sdcard, tempel ke chat
# ══════════════════════════════════════════════════════════════════
#
# Ini template. Isi dengan nilai HASIL ROTASI, bukan nilai lama.
# Lihat ROTASI-KREDENSIAL-URGENT.md.
#
# Prinsip berkas ini: HANYA yang dibutuhkan RocAgent untuk berjalan.
# Kredensial cloud dan pribadi ada di berkas terpisah, supaya kalau
# aplikasi ini disusupi, yang bocor tidak semuanya.

# ─── WAJIB ────────────────────────────────────────────────────────
# Server menolak start tanpa ini. Minimal 12 karakter.
# Buat dengan:  openssl rand -base64 24
# JANGAN pakai pola seperti "P@ssw0rd..." — itu ada di kamus penebak.
WEB_PASSWORD=

# ─── JARINGAN ─────────────────────────────────────────────────────
# 127.0.0.1 = hanya perangkat ini. Ini pilihan yang benar.
# Ubah HANYA ke alamat Tailscale bila memang perlu akses dari perangkat lain.
# JANGAN PERNAH 0.0.0.0
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# ─── GUARD PERINTAH SHELL ────────────────────────────────────────
# enforce = blokir perintah berbahaya (default, pertahankan)
# warn    = catat saja, tetap dijalankan  (tidak disarankan)
# off     = mati total                    (tidak disarankan)
SHELL_GUARD=enforce

# ─── PENYEDIA MODEL ──────────────────────────────────────────────
# Isi SATU saja. Menaruh banyak kunci memperluas area kebocoran
# tanpa manfaat — aplikasi hanya memakai satu pada satu waktu.
PROVIDER=groq

# Pilih satu sesuai PROVIDER di atas:
GROQ_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OR_KEY=

# ══════════════════════════════════════════════════════════════════
# Yang SENGAJA TIDAK ada di berkas ini:
#
#   Kredensial OCI    -> ~/.oci/config
#   Kunci SSH         -> ~/.ssh/ mode 600  (BUKAN /sdcard)
#   Token GitHub      -> gh auth login, atau kunci SSH
#   Cloudflare/Aiven/
#   Neon/Mongo        -> ~/.config/rocagent/cloud.env (terpisah)
#   Rahasia CI        -> GitHub Actions Secrets
#
# Kalau sebuah rahasia tidak dibutuhkan RocAgent untuk berjalan,
# ia tidak berhak ada di sini.
# ══════════════════════════════════════════════════════════════════
