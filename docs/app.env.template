# ══════════════════════════════════════════════════════════════════
#  RocAgent — konfigurasi aplikasi
#  Lokasi : ~/.config/rocagent/app.env
#  Izin   : chmod 600   (direktorinya chmod 700)
#  JANGAN : commit ke git, taruh di /sdcard, tempel ke chat
# ══════════════════════════════════════════════════════════════════

# ─── WAJIB ────────────────────────────────────────────────────────
# Server menolak start tanpa ini. Minimal 12 karakter.
#   openssl rand -base64 24
WEB_PASSWORD=

# ─── JARINGAN ─────────────────────────────────────────────────────
# 127.0.0.1 = hanya perangkat ini. Ini pilihan yang benar.
# Ubah HANYA ke alamat Tailscale bila perlu akses dari perangkat lain.
# JANGAN PERNAH 0.0.0.0
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# ─── GUARD PERINTAH SHELL ────────────────────────────────────────
# enforce = blokir perintah berbahaya (default, pertahankan)
# warn    = catat saja, tetap dijalankan  (tidak disarankan)
# off     = mati total                    (tidak disarankan)
SHELL_GUARD=enforce

# ─── PENYEDIA MODEL & URUTAN FAILOVER ────────────────────────────
# PROVIDER menerima DAFTAR dipisah koma. Yang pertama jadi utama, sisanya
# dicoba berurutan bila yang sebelumnya gagal. Entri tanpa kunci API
# dilewati otomatis, jadi aman mencantumkan lebih banyak dari yang diisi.
#
#   PROVIDER=groq                          satu saja
#   PROVIDER=groq,gemini,openai            failover berurutan
#
# Alias yang dikenali: xgoog/google -> gemini, deepseek -> openrouter,
#                      cf/cloudflare -> cfai
#
# Pertimbangan keamanan: makin banyak kunci di satu berkas, makin besar
# yang bocor bila berkas ini jatuh ke tangan lain. Kalau failover tidak
# benar-benar kamu butuhkan, cukup satu penyedia.
PROVIDER=groq,gemini,openai,openrouter,cfai

# --- Groq ---           console.groq.com/keys
GROQ_KEY=

# --- Google AI Studio --- aistudio.google.com/apikey
GEMINI_API_KEY=
# X_GOOG_API_KEY dipetakan ke penyedia yang sama (alias "xgoog")
# X_GOOG_API_KEY=

# --- OpenAI ---         platform.openai.com/api-keys
# Kunci restricted WAJIB punya "Model capabilities: Write",
# kalau tidak endpoint chat ditolak meski kuncinya sah.
OPENAI_API_KEY=

# --- OpenRouter ---     openrouter.ai/keys
OR_KEY=
# DeepSeek dilayani lewat OpenRouter (alias "deepseek")
# DEEPSEK_API_KEY=

# --- Cloudflare Workers AI --- dash.cloudflare.com/profile/api-tokens
CF_AI_TOKEN=
CF_ACCOUNT_ID=

# ══════════════════════════════════════════════════════════════════
# Yang SENGAJA TIDAK ada di sini:
#
#   Kredensial OCI    -> ~/.oci/config
#   Kunci SSH         -> ~/.ssh/ mode 600  (BUKAN /sdcard)
#   Token GitHub      -> kunci SSH, atau gh auth login
#   Cloudflare R2,
#   Aiven, Neon, Mongo -> ~/.config/rocagent/cloud.env
#   Rahasia CI        -> GitHub Actions Secrets
#
# Ollama/OCI lokal telah dihapus — VM lama yang menjalankannya sudah tidak
# ada, dan menyisakannya di rantai failover hanya menambah satu percobaan
# gagal pada setiap permintaan.
# ══════════════════════════════════════════════════════════════════
