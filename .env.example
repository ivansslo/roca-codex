# .env.example
# Documented environment variables for ROC Agents Workspace

# --- REQUIRED ---
# The server refuses to start without this. Minimum 12 characters.
# Generate:  openssl rand -base64 24
WEB_PASSWORD=

# Network binding. Default is 127.0.0.1 (loopback only) and that is the safe choice.
# Only change it if the network is trusted, e.g. a Tailscale address:
#   HOST=100.x.y.z
HOST=127.0.0.1

# Shell command guard for run_bash_command / terminal_manager / ssh_run.
#   enforce (default) = block dangerous commands
#   warn              = log only, still executes  (NOT recommended)
#   off               = disable entirely          (NOT recommended)
# This is a seatbelt against agent mistakes, not a sandbox. See server/commandGuard.ts.
SHELL_GUARD=enforce

GEMINI_API_KEY=
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# AI Provider Keys
GROQ_KEY=
OPENAI_API_KEY=
OR_KEY=
DEEPSEK_API_KEY=
X_GOOG_API_KEY=

# Cloud & Database Services
AIVEN_PG_URI=
AIVEN_PG2_URI=
NEON_URI=
MONGO_URI=

# Auth Services
CLERK_PK=
CLERK_SK=
CLERK_SECRET_KEY=

# Infrastructure & Integration Services
CF_ACCOUNT_ID=
CF_ZONE_ID=
SOLACE_HOST=
TAILSCALE_KEY=
